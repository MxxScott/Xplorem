# TMDB — https://www.themoviedb.org/settings/api
# Use the "API Key (v3 auth)" value, not the read access token.
VITE_TMDB_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# The anon/public key only. Never put a service-role key in a VITE_ variable:
# Vite inlines these into the client bundle, so anything here ships to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
